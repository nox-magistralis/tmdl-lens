#!/bin/sh
PYTHON=""
for candidate in "$HOME/.venvs/tmdl-lens/bin/python" python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -m pytest --version >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "pre-push: no Python with pytest found, tests skipped"
    exit 0
fi
"$PYTHON" -m pytest -q || {
    echo "pre-push: tests failed, push aborted"
    exit 1
}
